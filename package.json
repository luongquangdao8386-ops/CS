{
  "name": "checksheet",
  "private": true,
  "version": "1.0.0-d1.1",
  "description": "Checksheet · 点检表 — kiểm tra thiết bị hằng ngày. Google Apps Script + PWA (GitHub Pages)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test \"tests/server/*.test.mjs\"",
    "test:ui": "node tools/build.mjs && node --test \"tests/ui/*.test.mjs\"",
    "check": "node tools/build.mjs && node --test \"tests/server/*.test.mjs\" && node tools/scan-secrets.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
